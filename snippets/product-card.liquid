{%- comment -%}
  Uso: {% render 'product-card', product: product %}  — o sin producto para mostrar un marcador.
{%- endcomment -%}
{%- if product != blank -%}
  {%- liquid
    assign on_sale = false
    if product.compare_at_price > product.price
      assign on_sale = true
      assign saving = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
    endif
  -%}
  <a class="card" href="{{ product.url }}">
    <div class="card__media">
      {%- unless product.available -%}
        <span class="card__badge card__badge--soldout">{{ 'products.product.sold_out' | t }}</span>
      {%- else -%}
        {%- if on_sale -%}<span class="card__badge">{{ 'products.product.save_percent' | t: percent: saving }}</span>{%- endif -%}
      {%- endunless -%}
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '360, 533, 720, 800', alt: product.featured_media.alt | default: product.title }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <h3 class="card__title">{{ product.title | escape }}</h3>
    <div class="price">
      {%- if on_sale -%}
        <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
        <span class="price__sale">{% if product.price_varies %}{{ 'products.product.from' | t }}{% endif %}{{ product.price | money }}</span>
        <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
        <s class="price__compare">{{ product.compare_at_price | money }}</s>
      {%- else -%}
        <span class="price__sale">{% if product.price_varies %}{{ 'products.product.from' | t }}{% endif %}{{ product.price | money }}</span>
      {%- endif -%}
    </div>
  </a>
{%- else -%}
  <div class="card">
    <div class="card__media">{{ 'product-' | append: index | placeholder_svg_tag }}</div>
    <h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3>
    <div class="price"><span class="price__sale">{{ 1999 | money }}</span></div>
  </div>
{%- endif -%}
