<section class="sf-pdp">
  <div class="page-width sf-pdp__split">
    <img src="{{ 'symfino-how.jpg' | asset_url }}" width="1024" height="1024" alt="How Symfino One monitors the room, identifies a potential fall, and sends a phone alert.">
    <div>
      <p class="sf-kicker">How it works</p>
      <h2>From the room to a phone alert.</h2>
      <ol>
        <li><strong>Monitors the room.</strong> 60GHz mmWave radar monitors movement in the covered room.</li>
        <li><strong>Identifies a potential fall.</strong> The system can identify movement patterns consistent with a potential fall.</li>
        <li><strong>Sends a phone alert.</strong> Fall detection push notifications are sent through the Tuya Smart app when Wi-Fi and internet are available. There is no mandatory subscription. Optional SMS and phone-call alerts may require additional fees.</li>
      </ol>
      <a class="button" href="#ProductBuy">Add to cart</a>
    </div>
  </div>

  <div class="sf-pdp__benefits">
    <div class="page-width sf-pdp__three">
      <article>
        <img src="{{ 'symfino-care.jpg' | asset_url }}" width="1024" height="1024" alt="Care without compromise.">
        <h2>No camera in the room</h2>
        <p>It senses movement. It doesn't watch people. No images or video.</p>
      </article>
      <article>
        <img src="{{ 'symfino-peace.jpg' | asset_url }}" width="1024" height="1024" alt="Nothing to wear.">
        <h2>Nothing to wear</h2>
        <p>No wearable is required.</p>
      </article>
      <article>
        <img src="{{ 'symfino-lifestyle.jpg' | asset_url }}" width="1024" height="594" alt="Preserves privacy and dignity.">
        <h2>Preserves privacy and dignity</h2>
        <p>Symfino One gives families a discreet way to stay informed while helping preserve independence, privacy, and dignity.</p>
      </article>
    </div>
  </div>

  <div class="page-width sf-pdp__extra">
    <h2>Key Features</h2>
    <div class="sf-pdp__feats">
      <article><h3>Fall Detection</h3><p>Identifies potential falls in real time</p></article>
      <article><h3>Bathroom Use</h3><p>Tracks extended or frequent use</p></article>
      <article><h3>Activity Changes</h3><p>Alerts on significant routine changes</p></article>
    </div>
    <h2>Watch How Symfino One Works</h2>
    <video src="{{ 'symfino-home.mp4' | asset_url }}" width="1024" height="576" autoplay muted loop playsinline preload="metadata" aria-label="Symfino One in the home"></video>
    <h2>Fits Seamlessly Into Your Home</h2>
    <div class="sf-pdp__rooms">
      <figure><img src="{{ 'symfino-room-bedroom.jpg' | asset_url }}" width="1024" height="571" alt="A bedroom."><figcaption>Bedroom</figcaption></figure>
      <figure><img src="{{ 'symfino-room-living.jpg' | asset_url }}" width="1024" height="571" alt="A living room."><figcaption>Living Room</figcaption></figure>
      <figure><img src="{{ 'symfino-room-bathroom.jpg' | asset_url }}" width="1024" height="571" alt="A bathroom."><figcaption>Bathroom</figcaption></figure>
    </div>
  </div>

  <div class="sf-pdp__fit">
    <div class="page-width sf-pdp__split">
      <div>
        <p class="sf-kicker">Compatibility</p>
        <h2>Designed for real homes.</h2>
        <p>60GHz mmWave radar. Camera-free. No wearable. Works with the Tuya Smart app.</p>
        <p>2.4GHz Wi-Fi required for remote alerts. Designed primarily for one person in the covered room.</p>
        <h3>App &amp; Connectivity</h3>
        <p><strong>App Compatibility:</strong> Works with the Tuya Smart app.</p>
        <p><strong>Fall Detection Alerts:</strong> Receive fall detection push notifications directly on your smartphone without a mandatory subscription.</p>
        <p><strong>Optional Alerts:</strong> SMS and phone-call notifications may require additional fees.</p>
        <h3>1-Year Limited Warranty</h3>
        <p>Symfino One includes a 1-year limited warranty covering manufacturing defects. If your device experiences a qualifying defect during the warranty period, we will provide a replacement at no additional cost.</p>
        <p>Estimated Shipping: Approximately 10 Business Days. This estimate is for shipping to the United States. It is not a guaranteed delivery date. We do not accept returns for change of mind.</p>
        <p class="sf-note">Important: False or missed alerts are possible due to factors including positioning, obstructions, room conditions, pets, multiple people, or slow and unusual falls. Symfino One is not a medical device or a substitute for emergency assistance.</p>
      </div>
      <img src="{{ 'symfino-fit.jpg' | asset_url }}" width="1024" height="1024" alt="Compatibility, Wi-Fi, and warranty.">
    </div>
  </div>
</section>

{% stylesheet %}
  .sf-pdp { padding-bottom: 24px; }
  .sf-kicker { margin: 0 0 8px; color: var(--color-accent); font-size: 13px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .sf-pdp h2 { margin: 0 0 12px; letter-spacing: -.03em; }
  .sf-pdp h3 { margin: 22px 0 8px; font-size: 18px; }
  .sf-pdp__fit h3 { color: #fff; }
  .sf-pdp p, .sf-pdp li { color: var(--color-muted); }
  .sf-pdp__split { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; padding-top: 56px; padding-bottom: 56px; }
  .sf-pdp img { width: 100%; border-radius: 32px; }
  .sf-pdp ol { margin: 0 0 20px; padding-left: 18px; display: flex; flex-direction: column; gap: 10px; }
  .sf-pdp__benefits { background: var(--color-surface); padding: 56px 0; }
  .sf-pdp__three { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .sf-pdp__three h2 { font-size: 22px; }
  .sf-note { font-weight: 600; }
  .sf-pdp__extra { padding-top: 8px; }
  .sf-pdp__extra h2 { margin-top: 36px; }
  .sf-pdp__feats, .sf-pdp__rooms { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .sf-pdp__feats article { text-align: center; padding: 22px 14px; border: 1px solid var(--color-border); border-radius: 16px; background: #fff; }
  .sf-pdp__feats h3 { margin: 0 0 6px; font-size: 15px; color: var(--color-text); }
  .sf-pdp__extra video { width: 100%; height: 320px; object-fit: cover; background: #111; }
  .sf-pdp__rooms figure { margin: 0; position: relative; }
  .sf-pdp__rooms img { height: 210px; object-fit: cover; border-radius: 0; }
  .sf-pdp__rooms figcaption { position: absolute; left: 10px; right: 10px; bottom: 10px; background: rgba(255,255,255,.92); border-radius: 10px; text-align: center; font-weight: 700; padding: 8px; color: var(--color-text); }
  .sf-pdp__fit { background: var(--color-dark); color: var(--color-dark-text); }
  .sf-pdp__fit p, .sf-pdp__fit li { color: var(--color-dark-text); }
  .sf-pdp__fit h2 { color: #fff; }
  .sf-pdp__fit .button { background: #fff; color: var(--color-text); border-color: #fff; }
  @media (max-width: 800px) {
    .sf-pdp__split, .sf-pdp__three, .sf-pdp__feats, .sf-pdp__rooms { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Historia del producto",
  "tag": "section",
  "class": "section-symfino-pdp",
  "enabled_on": { "templates": ["product"] },
  "settings": [],
  "presets": [{ "name": "Historia del producto" }]
}
{% endschema %}
