{%- liquid
  assign faq_url = pages['faq'].url | default: '/pages/faq'
  assign care_url = pages['care'].url | default: '/pages/care'
  assign contact_url = pages['contact'].url | default: '/pages/contact'
  assign shop_url = routes.all_products_collection_url
  assign first_product = collections.all.products.first
  if first_product
    assign shop_url = first_product.url
  endif
  assign shipping_url = pages['care'].url | default: '/pages/care' | append: '#shipping'
  assign warranty_url = pages['care'].url | default: '/pages/care' | append: '#warranty'
  assign privacy_url = shop.privacy_policy.url | default: pages['contact'].url | default: '/pages/contact' | append: '#privacy'
  assign terms_url = shop.terms_of_service.url | default: pages['contact'].url | default: '/pages/contact' | append: '#terms'
-%}
<div class="sy">
  <footer class="site-footer">
    <div class="wrap foot">
      <a class="logo" href="{{ routes.root_url }}"><img src="{{ 'symfino-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1100" height="246" loading="lazy"></a>
      <div>
        <h2>Shop</h2>
        <ul>
          <li><a href="{{ shop_url }}">Symfino One</a></li>
          <li><a href="{{ routes.root_url }}#features">Features</a></li>
        </ul>
      </div>
      <div>
        <h2>Support</h2>
        <ul>
          <li><a href="{{ faq_url }}">FAQ</a></li>
          <li><a href="{{ contact_url }}">Contact Us</a></li>
        </ul>
      </div>
      <div>
        <h2>Company</h2>
        <ul>
          <li><a href="{{ care_url }}">About Symfino</a></li>
        </ul>
      </div>
      <div>
        <h2>Legal</h2>
        <ul>
          <li><a href="{{ shipping_url }}">Shipping &amp; Returns</a></li>
          <li><a href="{{ warranty_url }}">Warranty</a></li>
          <li><a href="{{ privacy_url }}">Privacy Policy</a></li>
          <li><a href="{{ terms_url }}">Terms of Service</a></li>
        </ul>
      </div>
    </div>
    <p class="copy">&copy; {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: shop.name | escape }}. All rights reserved.</p>
  </footer>
</div>

{% schema %}
{
  "name": "Pie de página",
  "class": "section-footer",
  "settings": []
}
{% endschema %}
