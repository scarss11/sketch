<section class="section">
  <div class="page-width">
    <div class="page-content">
      <h1 class="h2" style="text-align:center">{{ page.title | default: 'Contact' | escape }}</h1>
      {%- if page.content != blank -%}
        <div class="rte" style="margin-bottom:32px">{{ page.content }}</div>
      {%- else -%}
        <p style="color:var(--color-muted);margin:0 0 32px">Questions about orders, shipping, returns, or Symfino One.</p>
      {%- endif -%}
      {%- form 'contact', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message" role="status">{{ 'templates.contact.success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div style="display:flex;flex-direction:column;gap:16px">
          <div class="field">
            <label for="ContactName">{{ 'templates.contact.name' | t }}</label>
            <input id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
          </div>
          <div class="field">
            <label for="ContactEmail">{{ 'templates.contact.email' | t }}</label>
            <input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
          </div>
          <div class="field">
            <label for="ContactPhone">{{ 'templates.contact.phone' | t }}</label>
            <input id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
          </div>
          <div class="field">
            <label for="ContactBody">{{ 'templates.contact.message' | t }}</label>
            <textarea id="ContactBody" name="contact[body]" required>{{ form.body }}</textarea>
          </div>
          <div><button type="submit" class="button">{{ 'templates.contact.send' | t }}</button></div>
        </div>
      {%- endform -%}
      <div id="privacy" style="scroll-margin-top:96px;margin-top:40px">
        <h2>Privacy Policy</h2>
        <p>Symfino One does not record images or video. It senses movement in the room where it is installed. Account and order details are used to run the store, send the product, and reply to you. Remote alerts go through the Tuya Smart app on your own Wi-Fi.</p>
      </div>
      <div id="terms" style="scroll-margin-top:96px;margin-top:28px">
        <h2>Terms of Service</h2>
        <p>Symfino One is not a medical device and is not a substitute for emergency assistance. Alerts can be missed. By buying, you agree to the current price, the return policy, and the 1-year limited warranty. We do not accept returns for change of mind. Estimated Shipping: Approximately 10 Business Days to the United States. That estimate is not a guaranteed delivery date.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Formulario de contacto", "settings": [] }
{% endschema %}
