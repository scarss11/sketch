<section class="sf-band">
  <div class="sf-wrap sf-hero">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="sf-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="sf-title">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="sf-lede">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <p style="margin:28px 0 0"><a class="button" href="{{ section.settings.button_link | default: '#how' }}">{{ section.settings.button_label | escape }}</a></p>
      {%- endif -%}
    </div>
    <div class="sf-panel">
      <img
        src="{{ section.settings.image_name | asset_url }}"
        alt="{{ section.settings.image_alt | escape }}"
        width="1200"
        height="1200">
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Symfino",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Symfino One" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Care without compromise." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "The smarter way to stay informed. Privacy-first fall monitoring without cameras or wearables." },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "See how it works" },
    { "type": "text", "id": "button_link", "label": "Enlace del botón", "default": "#how" },
    { "type": "text", "id": "image_name", "label": "Archivo de imagen en assets", "default": "symfino-product.jpg" },
    { "type": "text", "id": "image_alt", "label": "Texto alternativo", "default": "Symfino One, a white camera-free fall monitor with its wall mount." }
  ],
  "presets": [{ "name": "Hero Symfino" }]
}
{% endschema %}
