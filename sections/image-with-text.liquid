<section class="section{% if section.settings.scheme == 'dark' %} scheme-dark{% elsif section.settings.scheme == 'surface' %} scheme-surface{% endif %}"{% if section.settings.compact_top %} style="padding-top:0"{% endif %}>
  <div class="page-width image-text{% if section.settings.layout == 'right' %} image-text--reverse{% endif %}">
    <div class="image-text__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1600', alt: section.settings.image.alt | default: '' }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="image-text__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <p class="{% if section.settings.scheme == 'dark' %}eyebrow{% else %}image-text__num{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- when 'heading' -%}
            <h2 class="h2" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
          {%- when 'text' -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            {%- if block.settings.label != blank -%}
              <a class="button{% if block.settings.secondary %} button--secondary{% endif %}" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Imagen con texto",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "select", "id": "layout", "label": "Posición de la imagen", "default": "left", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "right", "label": "Derecha" } ] },
    { "type": "select", "id": "scheme", "label": "Esquema de color", "default": "light", "options": [ { "value": "light", "label": "Claro" }, { "value": "surface", "label": "Blanco" }, { "value": "dark", "label": "Oscuro" } ] },
    { "type": "checkbox", "id": "compact_top", "label": "Quitar espacio superior", "info": "Úsalo para encadenar varios bloques seguidos.", "default": false }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Texto superior / número", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Texto", "default": "01" } ] },
    { "type": "heading", "name": "Título", "limit": 1, "settings": [ { "type": "text", "id": "heading", "label": "Título", "default": "Filo de navaja" } ] },
    { "type": "text", "name": "Texto", "limit": 1, "settings": [ { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Describe aquí un beneficio clave de tu producto.</p>" } ] },
    { "type": "button", "name": "Botón", "limit": 1, "settings": [
      { "type": "text", "id": "label", "label": "Texto", "default": "Comprar ahora" },
      { "type": "url", "id": "link", "label": "Enlace" },
      { "type": "checkbox", "id": "secondary", "label": "Estilo contorno", "default": false }
    ] }
  ],
  "presets": [
    { "name": "Imagen con texto", "blocks": [ { "type": "eyebrow" }, { "type": "heading" }, { "type": "text" } ] }
  ]
}
{% endschema %}
