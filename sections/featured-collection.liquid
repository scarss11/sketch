{%- assign collection = section.settings.collection -%}
<section class="section{% if section.settings.scheme == 'surface' %} scheme-surface{% endif %}" style="border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border)">
  <div class="page-width">
    <div class="section-heading">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" style="margin-bottom:8px">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | default: collection.title | escape }}</h2>
      </div>
      {%- if section.settings.show_view_all and collection != blank -%}
        <a class="link" href="{{ collection.url }}">{{ 'sections.featured_collection.view_all' | t }} →</a>
      {%- endif -%}
    </div>

    <ul class="product-grid{% if section.settings.layout == 'slider' %} product-grid--slider{% endif %}" role="list" style="--cols: {{ section.settings.columns }}; --cols-mobile: 2">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.columns) -%}
          <li>{% render 'product-card', index: i %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Colección destacada",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Colección destacada" },
    { "type": "text", "id": "heading", "label": "Título", "info": "Si lo dejas vacío se usa el nombre de la colección." },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "limit", "label": "Productos a mostrar", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columnas en escritorio", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "layout", "label": "Diseño", "default": "grid", "options": [ { "value": "grid", "label": "Grilla" }, { "value": "slider", "label": "Carrusel deslizable" } ] },
    { "type": "select", "id": "scheme", "label": "Fondo", "default": "surface", "options": [ { "value": "light", "label": "Claro" }, { "value": "surface", "label": "Blanco" } ] },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar \"Ver todo\"", "default": true }
  ],
  "presets": [{ "name": "Colección destacada" }]
}
{% endschema %}
