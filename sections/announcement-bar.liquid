<div class="sy">
  <p class="announce">
    {%- if section.settings.text_shipping != blank -%}
      <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg> {{ section.settings.text_shipping | escape }}</span>
    {%- endif -%}
    {%- if section.settings.text_returns != blank -%}
      <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8v5l3 2"/></svg> {{ section.settings.text_returns | escape }}</span>
    {%- endif -%}
    {%- if section.settings.text_warranty != blank -%}
      <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/></svg> {{ section.settings.text_warranty | escape }}</span>
    {%- endif -%}
  </p>
</div>

{% schema %}
{
  "name": "Barra de anuncio",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "text_shipping", "label": "Envío", "default": "Free U.S. Shipping" },
    { "type": "text", "id": "text_returns", "label": "Tiempo de envío", "default": "Estimated Shipping: Approximately 10 Business Days" },
    { "type": "text", "id": "text_warranty", "label": "Garantía", "default": "1-Year Limited Warranty" }
  ],
  "presets": [{ "name": "Barra de anuncio" }]
}
{% endschema %}
