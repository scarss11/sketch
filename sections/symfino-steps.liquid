<section class="sf-band sf-band--surface" id="how">
  <div class="sf-wrap">
    <div class="sf-split">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="sf-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="sf-heading">{{ section.settings.heading | escape }}</h2>
        <ol class="sf-grid" style="grid-template-columns:1fr;list-style:none;padding:0">
          {%- for block in section.blocks -%}
            <li class="sf-card" {{ block.shopify_attributes }}>
              <p class="sf-num">{{ forloop.index }}</p>
              <h3>{{ block.settings.title | escape }}</h3>
              <p>{{ block.settings.text | escape }}</p>
            </li>
          {%- endfor -%}
        </ol>
        {%- if section.settings.note != blank -%}
          <p class="sf-note">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      </div>
      <div class="sf-panel">
        <img
          src="{{ section.settings.image_name | asset_url }}"
          alt="{{ section.settings.image_alt | escape }}"
          width="1200"
          height="1200"
          loading="lazy">
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cómo funciona",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Título", "default": "From the room to your phone." },
    { "type": "text", "id": "note", "label": "Nota", "default": "Wi-Fi is required for remote alerts." },
    { "type": "text", "id": "image_name", "label": "Archivo de imagen en assets", "default": "symfino-how.jpg" },
    { "type": "text", "id": "image_alt", "label": "Texto alternativo", "default": "Symfino monitors the room, can identify a potential fall, and sends a phone alert." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Monitors the room" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "With 60GHz mmWave radar." }
      ]
    }
  ],
  "presets": [{ "name": "Cómo funciona" }]
}
{% endschema %}
