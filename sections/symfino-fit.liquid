<section class="sf-band sf-band--dark" id="fit">
  <div class="sf-wrap sf-fit">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="sf-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="sf-heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="sf-lede">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      <ul class="sf-list" style="margin-top:24px" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <strong>{{ block.settings.title | escape }}</strong>
            <span>{{ block.settings.text | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
    <div class="sf-panel">
      <img
        src="{{ section.settings.image_name | asset_url }}"
        alt="{{ section.settings.image_alt | escape }}"
        width="1200"
        height="1200"
        loading="lazy">
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Compatibilidad Symfino",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Important" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Real-world fit and compatibility" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Know what to expect. Designed for peace of mind." },
    { "type": "text", "id": "image_name", "label": "Archivo de imagen en assets", "default": "symfino-fit.jpg" },
    { "type": "text", "id": "image_alt", "label": "Texto alternativo", "default": "Symfino works with Tuya and Smart Life, needs 2.4GHz Wi-Fi, and is not a medical device." }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Dato",
      "settings": [
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "presets": [{ "name": "Compatibilidad Symfino" }]
}
{% endschema %}