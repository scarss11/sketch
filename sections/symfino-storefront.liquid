{%- liquid
  assign how_url = pages['how-it-works'].url | default: '/pages/how-it-works'
  assign contact_url = pages['contact'].url | default: '/pages/contact'
  assign shop_url = routes.all_products_collection_url
  assign first_product = collections.all.products.first
  if first_product
    assign shop_url = first_product.url
  endif
-%}
<div class="sy">
      <section class="hero">
        <picture>
          <source media="(max-width: 800px)" srcset="{{ 'symfino-hero-mobile.jpg' | asset_url }}">
          <img src="{{ 'symfino-hero.jpg' | asset_url }}" width="1024" height="434" alt="Symfino One on a table." fetchpriority="high">
        </picture>
        <div class="hero-copy">
          <p class="eyebrow">Symfino One</p>
          <h1>Care Without Compromise</h1>
          <p class="lede">Camera-free fall monitoring that helps you stay informed and give your loved ones more peace of mind.</p>
          <a class="button" href="{{ shop_url }}">Shop Symfino One <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="wrap">
        <div class="perks">
          <article><div class="mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s4-6 10-6 10 6 10 6-4 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="3"/><path d="M4 5l15 15"/></svg></div><h2>Camera-Free</h2><p>Privacy by design</p></article>
          <article><div class="mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="7"/><path d="M8 12h8"/><path d="M15 5l2 3M9 19l-2 2"/></svg></div><h2>No Wearables</h2><p>Nothing to wear</p></article>
          <article><div class="mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 15a7 7 0 0 1 14 0"/><path d="M8 15a4 4 0 0 1 8 0"/><circle cx="12" cy="18" r="1"/></svg></div><h2>60GHz mmWave</h2><p>Advanced</p></article>
          <article><div class="mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/></svg></div><h2>Phone Alerts</h2><p>Stay informed</p></article>
        </div>
      </section>

      <section class="wrap problem">
        <div>
          <p class="kicker">The Problem</p>
          <h2>Falls Are Common. Warnings Aren't.</h2>
          <p>A fall at home can happen to anyone, often without warning. The consequences can be serious, but help doesn't always arrive in time.</p>
        </div>
        <div class="problem-photo"><img src="{{ 'symfino-problem.jpg' | asset_url }}" width="1024" height="594" loading="lazy" alt="A person at home."></div>
      </section>

      <section class="bleed">
        <div class="solution">
          <img src="{{ 'symfino-wall.jpg' | asset_url }}" width="1024" height="571" loading="lazy" alt="Symfino One on the wall.">
          <div>
            <p class="kicker">The Solution</p>
            <h2>A Smarter, Simpler Way to Stay Informed</h2>
            <button class="more" type="button" aria-expanded="false" aria-controls="solution-text" aria-label="Show more"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            <p id="solution-text">Using 60GHz mmWave sensing, Symfino One detects unusual movement patterns, such as a possible fall, and sends an alert to your phone.</p>
            <a class="button light" href="{{ shop_url }}">Shop Symfino One <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section class="wrap band" id="how">
        <p class="kicker">How It Works</p>
        <h2>Simple. Discreet. Effective.</h2>
        <div class="steps">
          <article>
            <div class="circle"><img src="{{ 'symfino-step-1.jpg' | asset_url }}" width="1024" height="1024" loading="lazy" alt="Symfino One sensing the room."><span class="badge">1</span></div>
            <h3>1. Monitors the Room</h3>
            <p>Place it on a shelf or the wall. It senses movement with 60GHz radar. No camera, and nothing to wear.</p>
          </article>
          <div class="arrow" aria-hidden="true">→</div>
          <article>
            <div class="circle"><img src="{{ 'symfino-step-2.jpg' | asset_url }}" width="1024" height="1024" loading="lazy" alt="A possible fall at home."><span class="badge">2</span></div>
            <h3>2. Detects Unusual Movement</h3>
            <p>If the movement looks like a possible fall, Symfino One flags it.</p>
          </article>
          <div class="arrow" aria-hidden="true">→</div>
          <article>
            <div class="circle"><img src="{{ 'symfino-step-3.jpg' | asset_url }}" width="1024" height="1024" loading="lazy" alt="A phone alert from Symfino."><span class="badge">3</span></div>
            <h3>3. Sends an Alert to Your Phone</h3>
            <p>You get a fall detection push notification in the Tuya Smart app when the home has 2.4GHz Wi-Fi. There is no mandatory subscription. Optional SMS and phone-call alerts may require additional fees.</p>
          </article>
        </div>
      </section>

      <section class="bleed">
        <div class="living">
          <img src="{{ 'symfino-living.jpg' | asset_url }}" width="1024" height="571" loading="lazy" alt="Designed for independent living.">
          <div>
            <h2>Designed for Independent Living</h2>
            <p>Support safety and confidence at home — without changing daily routines.</p>
          </div>
        </div>
      </section>

      <section class="wrap" id="features">
        <h2 class="section-title">Key Features</h2>
        <div class="feats">
          <article><div class="mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="5" r="2"/><path d="M8 22l4-8 4 8M12 9v5"/></svg></div><h2>Fall Detection</h2><p>Identifies potential falls in real time</p></article>
          <article><div class="mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 18V9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v9"/><path d="M3 14h18"/></svg></div><h2>Sleep Activity</h2><p>Notifies unusual sleep patterns</p></article>
          <article><div class="mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 20V8a2 2 0 0 1 2-2h3v14"/><path d="M11 10h5a2 2 0 0 1 2 2v8"/></svg></div><h2>Bathroom Use</h2><p>Tracks extended or frequent use</p></article>
          <article><div class="mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="5" r="2"/><path d="M12 7v6l4 6M8 19l4-6"/></svg></div><h2>Activity Changes</h2><p>Alerts on significant routine changes</p></article>
        </div>
      </section>

      <section class="wrap action">
        <div class="player">
          <video src="{{ 'symfino-home.mp4' | asset_url }}" width="1024" height="576" autoplay muted loop playsinline preload="metadata" aria-label="Symfino One in the home"></video>
        </div>
        <div>
          <p class="kicker">See It in Action</p>
          <h2>Watch How Symfino One Works</h2>
          <p>A quick look at how it fits into your home and daily life.</p>
        </div>
      </section>

      <section class="wrap rooms-wrap">
        <h2 class="section-title">Fits Seamlessly Into Your Home</h2>
        <div class="rooms">
          <figure><img src="{{ 'symfino-room-bedroom.jpg' | asset_url }}" width="1024" height="571" loading="lazy" alt="A bedroom."><figcaption>Bedroom</figcaption></figure>
          <figure><img src="{{ 'symfino-room-living.jpg' | asset_url }}" width="1024" height="571" loading="lazy" alt="A living room."><figcaption>Living Room</figcaption></figure>
          <figure><img src="{{ 'symfino-room-bathroom.jpg' | asset_url }}" width="1024" height="571" loading="lazy" alt="A bathroom."><figcaption>Bathroom</figcaption></figure>
        </div>
      </section>

      <section class="wrap reviews">
        <h2 class="section-title">Customer Reviews</h2>
        <div class="review-grid">
          <article><p class="stars" aria-label="5 stars">★★★★★</p><p>“We set it on a shelf in the living room. No camera, nothing to wear, and the phone alert was easy to understand.”</p><p class="who">Andrea L.</p></article>
          <article><p class="stars" aria-label="5 stars">★★★★★</p><p>“Setup took a few minutes. It stays out of the way and the app shows when something unusual happens.”</p><p class="who">James P.</p></article>
          <article><p class="stars" aria-label="5 stars">★★★★★</p><p>“I wanted movement sensing, not video. This is the simple version of that.”</p><p class="who">Priya S.</p></article>
        </div>
      </section>

      <section class="wrap">
        <h2 class="section-title">Frequently Asked Questions</h2>
        <div class="ask">
          <details><summary>Does it use a camera?</summary><p>No. Symfino One uses 60GHz mmWave radar. It does not record images or video.</p></details>
          <details><summary>Is there anything to wear?</summary><p>No. Nothing to wear.</p></details>
          <details><summary>What Wi-Fi do I need?</summary><p>2.4GHz Wi-Fi is required for remote alerts.</p></details>
          <details><summary>How are alerts sent?</summary><p>Fall detection push notifications are sent through the Tuya Smart app when Wi-Fi and internet are available.</p></details>
          <details><summary>Do I need a subscription to receive fall alerts?</summary><p>No. Symfino One sends fall detection push notifications through the Tuya Smart app without a mandatory subscription. Optional SMS and phone-call alerts may incur additional charges.</p></details>
          <details><summary>Is it a medical device?</summary><p>No. It is not a medical device or a substitute for emergency assistance.</p></details>
        </div>
        <p class="note">Alerts can be missed. Positioning, obstructions, room conditions, pets, multiple people, and slow or unusual falls can affect detection.</p>
      </section>

      <section class="bleed">
        <div class="cta">
          <img src="{{ 'symfino-hero.jpg' | asset_url }}" width="1024" height="434" loading="lazy" alt="Symfino One">
          <div>
            <h2>Get Symfino One Today</h2>
            <p>A simple, private way to stay informed at home.</p>
            <a class="button light" href="{{ shop_url }}">Shop Symfino One <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section class="wrap loop">
        <h2 class="section-title">Stay in the Loop</h2>
        <p>Get product updates, tips, and more.</p>
        {%- form 'customer', id: 'HomeNewsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label for="HomeNewsletterEmail">Email</label>
          <input id="HomeNewsletterEmail" type="email" name="contact[email]" placeholder="Enter your email" autocomplete="email" required>
          <button type="submit" aria-label="Subscribe">→</button>
          {%- if form.posted_successfully? -%}<p class="form-message" role="status">Thanks for subscribing.</p>{%- endif -%}
        {%- endform -%}
      </section>
</div>

{% schema %}
{
  "name": "Inicio Symfino",
  "tag": "section",
  "class": "section-symfino-storefront",
  "enabled_on": { "templates": ["index"] },
  "settings": [],
  "presets": [{ "name": "Inicio Symfino" }]
}
{% endschema %}
