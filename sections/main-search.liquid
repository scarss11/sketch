<section class="section">
  <div class="page-width">
    <h1 class="h2" style="margin-bottom:24px">{{ 'general.search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:40px">
      <div class="field" style="flex:1 1 280px">
        <label for="SearchInput">{{ 'general.search.label' | t }}</label>
        <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}">
      </div>
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="button" style="align-self:flex-end">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 16 -%}
        {%- if search.results_count > 0 -%}
          <p style="color:var(--color-muted)">{{ 'general.search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
          <ul class="product-grid" role="list" style="--cols: 4">
            {%- for item in search.results -%}
              <li>
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', product: item %}
                {%- else -%}
                  <a class="card" href="{{ item.url }}"><h3 class="card__title">{{ item.title | escape }}</h3></a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <div class="empty-state"><p>{{ 'general.search.no_results' | t: terms: search.terms }}</p></div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Búsqueda", "settings": [] }
{% endschema %}
