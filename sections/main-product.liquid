{%- assign current_variant = product.selected_or_first_available_variant -%}
<section class="section" id="ProductBuy">
  <div class="page-width product">
    <div class="product-gallery" data-gallery>
      <div class="product-gallery__stage">
        {%- if section.settings.video != blank -%}
          <div class="product-gallery__panel is-active" data-gallery-panel="video">
            {{ section.settings.video | video_tag: controls: true, image_size: '1200x' }}
          </div>
        {%- endif -%}
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <div class="product-gallery__panel{% if section.settings.video == blank and forloop.first %} is-active{% endif %}" data-gallery-panel="media-{{ media.id }}">
              {%- if media.media_type == 'image' -%}
                {{ media | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 55vw, 100vw', widths: '600, 900, 1200, 1400', alt: media.alt | default: product.title }}
              {%- else -%}
                {{ media | media_tag: image_size: '1400x' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- elsif section.settings.video == blank -%}
          <div class="product-gallery__panel is-active" data-gallery-panel="stock-product">
            <img src="{{ 'symfino-table.jpg' | asset_url }}" width="1024" height="681" alt="Symfino One">
          </div>
          <div class="product-gallery__panel" data-gallery-panel="stock-wall">
            <img src="{{ 'symfino-wall.jpg' | asset_url }}" width="1024" height="571" alt="Symfino One on the wall">
          </div>
          <div class="product-gallery__panel" data-gallery-panel="stock-living">
            <img class="frame-center" src="{{ 'symfino-gallery-living.jpg' | asset_url }}" width="1024" height="681" alt="Symfino One in a living room">
          </div>
          <div class="product-gallery__panel" data-gallery-panel="stock-kitchen">
            <img class="frame-center" src="{{ 'symfino-gallery-kitchen.jpg' | asset_url }}" width="1024" height="571" alt="Symfino One in a kitchen">
          </div>
        {%- endif -%}
      </div>
      <div class="product-gallery__thumbs">
        {%- if section.settings.video != blank -%}
          <button type="button" class="is-active" data-gallery-thumb="video" aria-label="Product video">Video</button>
        {%- endif -%}
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <button type="button" data-gallery-thumb="media-{{ media.id }}"{% if section.settings.video == blank and forloop.first %} class="is-active"{% endif %} aria-label="{{ product.title | escape }} {{ forloop.index }}">
              {%- if media.preview_image -%}
                {{ media.preview_image | image_url: width: 180 | image_tag: alt: '' }}
              {%- else -%}
                <span>{{ forloop.index }}</span>
              {%- endif -%}
            </button>
          {%- endfor -%}
        {%- elsif section.settings.video == blank -%}
          <button type="button" class="is-active" data-gallery-thumb="stock-product"><img src="{{ 'symfino-table.jpg' | asset_url }}" width="1024" height="681" alt=""></button>
          <button type="button" data-gallery-thumb="stock-wall"><img src="{{ 'symfino-wall.jpg' | asset_url }}" width="1024" height="571" alt=""></button>
          <button type="button" data-gallery-thumb="stock-living"><img class="frame-center" src="{{ 'symfino-gallery-living.jpg' | asset_url }}" width="1024" height="681" alt=""></button>
          <button type="button" data-gallery-thumb="stock-kitchen"><img class="frame-center" src="{{ 'symfino-gallery-kitchen.jpg' | asset_url }}" width="1024" height="571" alt=""></button>
        {%- endif -%}
      </div>
    </div>

    <div class="product__info">
      {%- if section.settings.show_vendor -%}<p class="eyebrow">{{ product.vendor | escape }}</p>{%- endif -%}
      <h1 class="h2">{{ product.title | escape }}</h1>

      <div class="price product__price">
        <span class="price__sale" data-product-price>{{ current_variant.price | money }}</span>
        <s class="price__compare" data-product-compare{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
      </div>
      {%- if cart.taxes_included -%}<p class="form-message" style="color:var(--color-muted)">{{ 'products.product.taxes_included' | t }}</p>{%- endif -%}

      {%- form 'product', product, data-product-form: '', data-money-format: shop.money_format -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
        <div style="display:flex;flex-direction:column;gap:20px">
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <fieldset class="variant-picker" data-option-position="{{ option.position }}">
                <legend>{{ option.name | escape }}</legend>
                <div class="variant-picker__options">
                  {%- for value in option.values -%}
                    <input type="radio" id="{{ section.id }}-{{ option.position }}-{{ forloop.index }}" name="{{ option.name | escape }}" value="{{ value | escape }}" data-option-index="{{ forloop.index0 }}"{% if option.selected_value == value %} checked{% endif %}>
                    <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index }}">{{ value | escape }}</label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}

          <div class="field">
            <label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
            <div class="quantity">
              <button type="button" data-qty="minus" aria-label="{{ 'products.product.decrease' | t }}">−</button>
              <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
              <button type="button" data-qty="plus" aria-label="{{ 'products.product.increase' | t }}">+</button>
            </div>
          </div>

          <div class="product__buttons">
            <button type="submit" name="add" class="button"
              data-add="{{ 'products.product.add_to_cart' | t }}"
              data-soldout="{{ 'products.product.sold_out' | t }}"
              data-unavailable="{{ 'products.product.unavailable' | t }}"
              {% unless current_variant.available %}disabled{% endunless %}>
              {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
            </button>
            {%- if section.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
          </div>
        </div>
        <script type="application/json" data-variants>
          [{%- for v in product.variants -%}{"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ v.available | json }},"price":{{ v.price }},"compare_at_price":{{ v.compare_at_price | default: 0 }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
        </script>
      {%- endform -%}

      <div class="product__details">
        <details>
          <summary>{{ section.settings.shipping_heading | escape }}</summary>
          <div class="rte">{{ section.settings.shipping_text }}</div>
        </details>
        <details>
          <summary>{{ section.settings.returns_heading | escape }}</summary>
          <div class="rte">{{ section.settings.returns_text }}</div>
        </details>
        <details>
          <summary>{{ section.settings.warranty_heading | escape }}</summary>
          <div class="rte">{{ section.settings.warranty_text }}</div>
        </details>
      </div>

      <div class="rte" style="color:var(--color-muted)">{{ product.description }}</div>
    </div>
  </div>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Producto",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Mostrar marca/proveedor", "default": false },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Mostrar botón de compra rápida", "default": true },
    { "type": "video", "id": "video", "label": "Video del producto" },
    { "type": "text", "id": "shipping_heading", "label": "Título de envío", "default": "Shipping & delivery" },
    { "type": "richtext", "id": "shipping_text", "label": "Texto de envío", "default": "<p>U.S. supplier shipping estimate: approximately 8 days. Actual delivery varies. 2.4GHz Wi-Fi is required for remote alerts.</p>" },
    { "type": "text", "id": "returns_heading", "label": "Título de devoluciones", "default": "Returns" },
    { "type": "richtext", "id": "returns_text", "label": "Texto de devoluciones", "default": "<p>See the store's current return policy for applicable terms.</p>" },
    { "type": "text", "id": "warranty_heading", "label": "Título de garantía", "default": "Warranty" },
    { "type": "richtext", "id": "warranty_text", "label": "Texto de garantía", "default": "<p>The device includes a 1-year limited hardware warranty. Symfino One is not a medical device.</p>" }
  ]
}
{% endschema %}
