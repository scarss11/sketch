{%- liquid
  assign how_url = pages['how-it-works'].url | default: '/pages/how-it-works'
  assign shop_url = routes.all_products_collection_url
  assign first_product = collections.all.products.first
  if first_product
    assign shop_url = first_product.url
  endif
  if customer
    assign account_url = routes.account_url
  else
    assign account_url = routes.account_login_url
  endif
-%}
<div class="sy">
  <header class="site-header">
    <div class="bar">
      <div class="start">
        <button class="icon-btn" type="button" aria-expanded="false" aria-controls="SiteNav" aria-label="Open menu" data-label-open="Open menu" data-label-close="Close menu">
          <svg class="icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
          <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
        <a class="logo" href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'eager' }}
          {%- else -%}
            <img src="{{ 'symfino-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1100" height="246">
          {%- endif -%}
        </a>
      </div>
      <nav id="SiteNav" class="site-nav" aria-label="Main">
        <ul>
          <li><a href="{{ shop_url }}">Symfino One</a></li>
          <li><a href="{{ how_url }}">How It Works</a></li>
          <li><a href="{{ routes.root_url }}#features">Features</a></li>
          <li class="only-mobile"><a href="{{ account_url }}">Account</a></li>
          <li class="only-mobile"><a href="{{ routes.cart_url }}">Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a></li>
        </ul>
      </nav>
      <div class="icons">
        <a class="icon-link" href="{{ routes.search_url }}" aria-label="Search"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg></a>
        <a class="icon-link" href="{{ account_url }}" aria-label="Account"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="8" r="3.2"/><path d="M5 19c1.4-3 3.8-4.5 7-4.5S17.6 16 19 19"/></svg></a>
        <a class="icon-link" href="{{ routes.cart_url }}" aria-label="Cart ({{ cart.item_count }})"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 7h12l-1 12H7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>{% if cart.item_count > 0 %}<span class="cart-count">{{ cart.item_count }}</span>{% endif %}</a>
      </div>
    </div>
  </header>
</div>

{% schema %}
{
  "name": "Encabezado",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Si lo dejas vacío se usa el logo de Symfino." }
  ]
}
{% endschema %}
