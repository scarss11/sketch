<header class="header" data-header{% if section.settings.hide_on_scroll %} data-hide-on-scroll{% endif %}>
  <div class="page-width header__inner">
    <div class="header__left">
      <button type="button" class="icon-button header__menu-toggle" data-menu-toggle aria-controls="HeaderNav" aria-expanded="false"
        aria-label="{{ 'sections.header.menu' | t }}"
        data-label-open="{{ 'sections.header.menu' | t }}"
        data-label-close="{{ 'sections.header.close_menu' | t }}">
        <span class="header__icon-open">{% render 'icon', icon: 'menu' %}</span>
        <span class="header__icon-close">{% render 'icon', icon: 'close' %}</span>
      </button>
    </div>

    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_h = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: width: section.settings.logo_width, height: logo_h, alt: shop.name, loading: 'eager' }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    <div class="header__icons">
      <a href="{{ routes.search_url }}" class="icon-button" aria-label="{{ 'general.search.title' | t }}">{% render 'icon', icon: 'search' %}</a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="icon-button" aria-label="{{ 'customer.account.title' | t }}">{% render 'icon', icon: 'account' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="icon-button" aria-label="{{ 'templates.cart.title' | t }} ({{ cart.item_count }})">
        {% render 'icon', icon: 'cart' %}
        {%- if cart.item_count > 0 -%}<span class="cart-count" aria-hidden="true">{{ cart.item_count }}</span>{%- endif -%}
      </a>

      {%- if section.settings.show_language_selector and localization.available_languages.size > 1 -%}
        {%- form 'localization', class: 'localization-form', id: 'HeaderLocalization' -%}
          <input type="hidden" name="return_to" value="{{ request.path }}">
          {%- for language in localization.available_languages -%}
            <button type="submit" name="locale_code" value="{{ language.iso_code }}" lang="{{ language.iso_code }}" aria-label="{{ language.endonym_name | capitalize }}"{% if language.iso_code == localization.language.iso_code %} aria-current="true"{% endif %}>{{ language.iso_code | slice: 0, 2 }}</button>
          {%- endfor -%}
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>

  <nav id="HeaderNav" class="header__nav" aria-label="{{ 'sections.header.nav_label' | t }}">
    <ul class="page-width">
      {%- for link in section.settings.menu.links -%}
        <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
      {%- endfor -%}
    </ul>
  </nav>
</header>

{% schema %}
{
  "name": "Encabezado",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Ancho del logo", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 140 },
    { "type": "link_list", "id": "menu", "label": "Menú", "default": "main-menu" },
    { "type": "checkbox", "id": "hide_on_scroll", "label": "Ocultar al bajar y mostrar al subir", "default": true },
    { "type": "checkbox", "id": "show_language_selector", "label": "Mostrar selector de idioma (ES/EN)", "info": "Agrega idiomas en Configuración › Idiomas.", "default": true }
  ]
}
{% endschema %}
